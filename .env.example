# ===================================================
# ♠️ VK Poker Club Mini App - Configuration Template
# ===================================================
# Используйте этот файл как шаблон при развертывании для нового клуба:
# 1. Скопируйте в .env (cp .env.example .env)
# 2. Заполните учетные данные VK App и базы данных
# 3. Запустите: docker compose up -d --build
# ===================================================

# 🔑 VK Mini App Credentials
VK_APP_ID=12345678
VK_PROTECTED_KEY=your_vk_app_secret_key_here
VK_ADMIN_IDS=123456789

# 🐘 PostgreSQL Database
DB_USER=poker_admin
DB_PASSWORD=super_secret_poker_password_2026
DB_NAME=poker_club_db
DB_PORT=5439

# 🌐 API & Ports
API_PORT=5052
CLIENT_PORT=3000

# 📊 Google Sheets Sync & Webhooks
GOOGLE_SHEETS_SPREADSHEET_ID=1zxU_LOSjIsjrEHw7eq366BQMLWQ4x8pSDIiMdUxWPOs
GOOGLE_SHEETS_SEASON_GID=202622
# URL вебхука Google Apps Script для авто-записи новых регистраций в лист «РЕГИСТРАЦИИ» (см. scripts/google-sheets-registration-webhook.js):
GOOGLE_SHEETS_REGISTRATION_WEBHOOK_URL=

# 🏢 Club & Branding Defaults
CLUB_NAME="Monte Carlo"
CLUB_CITY="Пермь"
CLUB_ADDRESS="Монастырская улица, 59, Пермь"